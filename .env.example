# Canonical origin used for metadata, robots.txt and the sitemap.
NEXT_PUBLIC_SITE_URL=https://avro.example.com

# Signs session cookies and one-time codes. Required in production, 32+ characters:
#   openssl rand -hex 32
AUTH_SECRET=

# "Sign in with Google" (Google Cloud console → OAuth client, type "Web application").
# Authorized redirect URI: <site url>/api/auth/google/callback (and http://localhost:3000/... for local).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
