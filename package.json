{
  "name": "avro-motion",
  "version": "1.0.0",
  "private": true,
  "description": "AVRO! — Taste the Sunrise. Scroll-driven product hero built with Next.js.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:engine && next build",
    "build:engine": "node scripts/build-engine.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "images": "node scripts/optimize-images.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3"
  }
}
